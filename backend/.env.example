# =============================================================================
# my-feeds Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myfeeds

# OAuth Providers
# Register applications at:
# - GitHub: https://github.com/settings/developers
# - Google: https://console.cloud.google.com/apis/credentials
# - Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Public URLs (must be browser-reachable)
# OAUTH_REDIRECT_BASE_URL builds the OAuth callback and must match the URI
# registered with each provider, e.g. http://localhost:5000/api/auth/github/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:5000
# Where users are redirected after signing in (the frontend origin).
FRONTEND_URL=http://localhost:5173

# Session Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production

# Text-to-Speech: "edge" (default, no key) or "azure"
TTS_PROVIDER=edge
# Uses Entra ID (az login locally); needs "Cognitive Services Speech User" on the resource.
AZURE_SPEECH_ENDPOINT=https://<name>.cognitiveservices.azure.com/

# Audio cache: local (default) or azure_blob.
# For Azure Blob, use a Storage Account service URL and an existing container.
# Azure authentication uses DefaultAzureCredential (managed identity in Azure).
AUDIO_CACHE_PROVIDER=local
AUDIO_CACHE_DIR=audio_cache
AZURE_BLOB_SERVICE_URL=https://your-storage-account.blob.core.windows.net
AZURE_BLOB_CONTAINER_NAME=audio-cache


# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=true
