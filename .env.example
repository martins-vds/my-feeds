# =============================================================================
# my-feeds — required Docker Compose configuration. Copy to .env and fill in.
# Generate each secret independently: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Postgres ---
POSTGRES_USER=myfeeds_admin
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_DB=myfeeds
POSTGRES_PORT=5432

# --- Backend runtime environment: development | testing | production ---
SECRET_KEY=
# Production requires a trusted HTTPS terminator forwarding to loopback nginx.
# Development override uses localhost; PUBLIC_BASE_URL must still be supplied.
PUBLIC_BASE_URL=https://feeds.example.org
EXTERNAL_TTS_ENABLED=false
ALLOW_EXTERNAL_IMAGES=false

# --- Host port mappings ---
BACKEND_PORT=5000
# Production frontend (nginx) host port. The dev override always serves Vite on 5173.
FRONTEND_PORT=8080
# Dev frontend (Vite) host port used by docker-compose.override.yml.
FRONTEND_DEV_PORT=5174
# Change these together if this isolated subnet conflicts with a local/VPN network.
MYFEEDS_NETWORK_SUBNET=172.30.16.0/24
FRONTEND_PROXY_IP=172.30.16.2
