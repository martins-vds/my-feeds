# =============================================================================
# my-feeds — docker compose variables. Copy to .env and adjust as needed.
# Every value has a sensible default, so .env is optional for local dev.
# =============================================================================

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myfeeds
POSTGRES_PORT=5432

# --- Backend runtime environment: development | testing | production ---
ENVIRONMENT=production

# --- Host port mappings ---
BACKEND_PORT=5000
# Production frontend (nginx) host port. The dev override always serves Vite on 5173.
FRONTEND_PORT=8080
# Dev frontend (Vite) host port used by docker-compose.override.yml.
FRONTEND_DEV_PORT=5174
