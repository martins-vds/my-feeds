# =============================================================================
# my-feeds .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/

# Node.js / JavaScript / TypeScript
node_modules/
*.tsbuildinfo
.npm
.pnpm-store/

# Build outputs
frontend/dist/
backend/dist/

# IDE
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Environment
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest_cache/
frontend/playwright-report/
frontend/playwright/.cache/
frontend/test-results/

# OS
.DS_Store
Thumbs.db
*.tmp

# Audio cache (generated at runtime)
backend/audio_cache/*
!backend/audio_cache/.gitkeep

# Alembic
*.pyc

# uv
.uv/

# Database
*.db
*.sqlite3
.azure/
